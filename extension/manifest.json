{
  "manifest_version": 3,
  "name": "PastDow Browser Capture",
  "version": "1.5.2",
  "description": "Send videos playing in your browser to PastDow",
  "minimum_chrome_version": "102",
  "permissions": ["webRequest", "webNavigation", "cookies", "tabs", "storage", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
